# Leave these blank. This repo does not ship secrets.
# Put TYPESAFE_API_KEY on the judge process only, after you have decided to add one.
# The desk process refuses to start if that variable is set.
# DESK_SECRET is a separate shared secret. It is not the Jev key.
# This desk has no exchange key and no withdrawal path.

TYPESAFE_API_KEY=
DESK_SECRET=
JUDGE_URL=http://127.0.0.1:8787
JUDGE_PORT=8787
DESK_MODE=shadow
